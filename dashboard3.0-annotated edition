      position: fixed;
      left: 50%;
      bottom: 24px;
      transform: translateX(-50%);
      padding: 14px 18px;
      border-radius: 999px;
      color: white;
      background: rgba(49, 41, 82, 0.94);
      box-shadow: 0 18px 38px rgba(49, 41, 82, 0.24);
      z-index: 40;
    }

    .ai-tag-row, .suggested-tags {
      display: flex;
      gap: 10px;
      align-items: center;
      flex-wrap: wrap;
    }

    .upload-progress {
      width: 100%;
      height: 10px;
      border-radius: 999px;
      background: rgba(102, 93, 228, 0.12);
      overflow: hidden;
    }

    .upload-progress-bar {
      width: 0;
      height: 100%;
      background: linear-gradient(90deg, #5b50ff, #8e85ff);
      transition: width 0.2s ease;
    }

    .form-error {
      padding: 12px 14px;
      border-radius: 14px;
      background: rgba(215, 66, 97, 0.12);
      color: #7b2542;
      font-size: 0.92rem;
    }

    .text-button.is-active { color: var(--danger); }

    .danger { color: var(--danger); }

    /* Image Search Styles */
    .image-search-content { display: grid; gap: 20px; }

    .image-upload-area {
      position: relative;
      min-height: 240px;
      padding: 20px;
      border-radius: 20px;
      border: 2px dashed rgba(103, 88, 255, 0.26);
      background: rgba(244, 240, 255, 0.78);
      cursor: pointer;
      transition: all 200ms ease;
    }

    .image-upload-area:hover {
      border-color: rgba(103, 88, 255, 0.46);
      background: rgba(244, 240, 255, 0.9);
    }

    .image-upload-area input {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
    }

    .upload-hint {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      gap: 12px;
    }

    .upload-icon { font-size: 3rem; }

    .image-preview-container {
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .preview-image {
      width: 120px;
      height: 120px;
      border-radius: 16px;
      background-size: cover;
      background-position: center;
      border: 1px solid var(--line);
    }

    .search-status {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      padding: 40px;
    }

    .similar-posts-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .similar-post-card {
      aspect-ratio: 1;
      border-radius: 16px;
      background-size: cover;
      background-position: center;
      cursor: pointer;
      border: 2px solid transparent;
      transition: all 180ms ease;
    }

    .similar-post-card:hover {
      border-color: var(--accent);
      transform: scale(1.02);
    }

    /* Report Modal Styles */
    .report-content { display: grid; gap: 20px; }

    .report-reasons {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .report-reason {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 16px;
      border-radius: 18px;
      background: rgba(245, 240, 255, 0.8);
      border: 2px solid transparent;
      text-align: left;
      transition: all 180ms ease;
    }

    .report-reason:hover {
      border-color: rgba(103, 88, 255, 0.2);
      background: rgba(245, 240, 255, 0.96);
    }

    .report-reason.is-selected {
      border-color: var(--accent);
      background: rgba(103, 88, 255, 0.08);
    }

    .reason-icon { font-size: 1.4rem; }

    .report-reason strong {
      display: block;
      color: var(--text-strong);
    }

    .report-reason small {
      color: var(--muted);
      font-size: 0.86rem;
    }

    /* Error & Unauthorized States */
    .error-state {
      padding: 40px;
      text-align: center;
      border-radius: 24px;
      background: rgba(215, 66, 97, 0.08);
    }

    .error-state h3 { color: var(--danger); }

    .unauthorized-state {
      padding: 40px;
      text-align: center;
      border-radius: 24px;
      background: rgba(103, 88, 255, 0.08);
    }

    .unauthorized-state h3 { color: var(--accent); }

    @media (max-width: 1360px) {
      .dashboard-screen { grid-template-columns: 220px minmax(0, 1fr); }
      .right-rail { display: none; }
      .detail-layout { grid-template-columns: 1fr; }
    }

    @media (max-width: 980px) {
      .dashboard-screen { grid-template-columns: 1fr; }
      .dashboard-topbar { grid-template-columns: 1fr; display: grid; }
      .topbar-actions { flex-direction: column; align-items: stretch; }
      .form-grid, .detail-metric-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 720px) {
      .dashboard-screen, .detail-shell {
