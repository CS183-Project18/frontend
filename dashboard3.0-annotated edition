    .preview-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .preview-card {
      position: relative;
      width: 100px;
      height: 100px;
      border-radius: 18px;
      background-size: cover;
      background-position: center;
      border: 1px solid var(--line);
    }

    .preview-remove {
      position: absolute;
      right: 10px;
      top: 10px;
    }

    .form-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

