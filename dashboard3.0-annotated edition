<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Curator | Dashboard</title>
  <style>
    :root {
      --bg: #f7f2ff;
      --bg-2: #efe8ff;
      --panel: rgba(255, 255, 255, 0.92);
      --panel-strong: rgba(255, 255, 255, 0.98);
      --line: rgba(102, 82, 170, 0.12);
      --line-strong: rgba(102, 82, 170, 0.2);
      --text: #453d73;
      --text-strong: #38305f;
      --muted: #8e88ae;
      --accent: #6758ff;
      --accent-soft: #9186ff;
      --accent-deep: #5143dc;
      --danger: #df637b;
      --shadow: 0 28px 80px rgba(88, 67, 167, 0.12);
      --radius-xl: 30px;
      --radius-lg: 24px;
      --radius-md: 18px;
      --shell: min(1600px, calc(100vw - 28px));
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      font-family: "SF Pro Display", "SF Pro Text", "Helvetica Neue", "Avenir Next", sans-serif;
      background:
        radial-gradient(circle at 8% 12%, rgba(157, 138, 255, 0.28), transparent 18%),
        radial-gradient(circle at 92% 14%, rgba(116, 102, 255, 0.18), transparent 18%),
        linear-gradient(180deg, #fcfbff 0%, var(--bg) 45%, #f6f2ff 100%);
    }
    button, input, textarea { font: inherit; }
    button { border: 0; }

    .ambient {
      position: fixed;
      width: 24rem;
      height: 24rem;
      border-radius: 999px;
      filter: blur(90px);
      opacity: 0.34;
      pointer-events: none;
      z-index: 0;
    }
    .ambient-a { top: -5rem; left: -6rem; background: rgba(110, 92, 255, 0.34); }
    .ambient-b { right: -8rem; bottom: -8rem; background: rgba(196, 126, 255, 0.24); }

    .hidden { display: none !important; }

    .dashboard-screen {
      position: relative;
      z-index: 1;
      width: var(--shell);
      min-height: calc(100vh - 28px);
      margin: 14px auto;
      display: grid;
      grid-template-columns: 250px minmax(0, 1fr) 330px;
      gap: 26px;
      padding: 20px;
      border-radius: 28px;
      background: rgba(250, 247, 255, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: var(--shadow);
    }

    .brand {
      font-size: 2rem;
      font-weight: 800;
      color: var(--accent-deep);
      letter-spacing: -0.06em;
    }

    .sidebar {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .sidebar-nav { display: grid; gap: 10px; }

    .nav-item, .filter-chip, .primary-button, .secondary-button {
      min-height: 48px;
      padding: 0 18px;
      border-radius: 16px;
      cursor: pointer;
      transition: transform 180ms ease, background 180ms ease, color 180ms ease, box-shadow 180ms ease;
    }

    .nav-item, .filter-chip, .secondary-button {
      color: var(--text-strong);
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid var(--line);
    }

    .nav-item.is-active, .filter-chip.is-active, .primary-button {
      color: white;
      background: linear-gradient(135deg, var(--accent), var(--accent-soft));
      border-color: transparent;
      box-shadow: 0 14px 34px rgba(103, 88, 255, 0.24);
    }

    .nav-item:hover, .filter-chip:hover, .primary-button:hover, .secondary-button:hover {
      transform: translateY(-1px);
    }

    .primary-button.wide, .secondary-button.wide { width: 100%; }

    .profile-card {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 16px;
      border-radius: 18px;
      background: rgba(245, 240, 255, 0.8);
    }

    .avatar {
      display: grid;
      place-items: center;
      width: 50px;
      height: 50px;
      border-radius: 16px;
      color: white;
      font-weight: 700;
      background: linear-gradient(135deg, #493f62, #231e34);
    }

    .avatar.small {
      width: 34px;
      height: 34px;
      border-radius: 12px;
      font-size: 0.76rem;
    }

    .profile-card strong, .meta-author strong { display: block; }
    .profile-card span, .meta-author span { color: var(--muted); }

    /* Chenqing Fu (Responsibilities: Authentication & User Management, Navigation & Routing, Main Content Layout): Main dashboard layout - Tight spacing between elements */
    .dashboard-main {
      display: flex;
      flex-direction: column;
      gap: 12px;
      position: relative;
    }

    .loading-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(247, 242, 255, 0.9);
      z-index: 10;
    }

    .loading-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .loading-spinner {
      width: 48px;
      height: 48px;
      border: 4px solid rgba(103, 88, 255, 0.1);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    .loading-spinner.large { width: 64px; height: 64px; }

    @keyframes spin { to { transform: rotate(360deg); } }

    .dashboard-topbar {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      align-items: start;
      margin-bottom: 0;
    }

    .dashboard-topbar h1 {
      margin: 0;
      font-size: clamp(2.6rem, 4vw, 4rem);
      line-height: 0.94;
      letter-spacing: -0.06em;
      color: var(--text-strong);
    }

    .dashboard-topbar p {
      margin: 10px 0 0;
      color: var(--muted);
      font-size: 1.08rem;
    }

    .topbar-actions {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .search-shell {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 12px;
      min-height: 72px;
      padding: 0 18px;
      border-radius: 24px;
      background: white;
      box-shadow: 0 14px 36px rgba(103, 88, 255, 0.08);
    }

    .search-shell span { color: var(--accent); }

    .search-shell small {
      color: var(--accent-soft);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .search-camera { font-size: 1.2rem; padding: 0 8px; }

    .icon-pill {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 48px;
      padding: 0 18px;
      border-radius: 16px;
      color: var(--text-strong);
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid var(--line);
    }

    .icon-pill strong {
      display: inline-grid;
      place-items: center;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      color: white;
      background: linear-gradient(135deg, var(--accent), var(--accent-soft));
      font-size: 0.8rem;
    }

    /* Chenqing Fu (Responsibilities: Authentication & User Management, Navigation & Routing, Main Content Layout): Filter bar with consistent button widths */
    .filter-bar {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    /* Chenqing Fu (Responsibilities: Authentication & User Management, Navigation & Routing, Main Content Layout): Filter buttons with consistent width - all buttons same width */
    .filter-chip {
      flex: 1;
      min-width: 100px;
      max-width: 140px;
      min-height: 48px;
      padding: 0 18px;
      border-radius: 16px;
      cursor: pointer;
      transition: transform 180ms ease, background 180ms ease, color 180ms ease, box-shadow 180ms ease;
      color: var(--text-strong);
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid var(--line);
      text-align: center;
    }

    .masonry-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 18px;
      margin-top: 0;
      width: 100%;
    }

    /* Chenqing Fu (Responsibilities: Authentication & User Management, Navigation & Routing, Main Content Layout): Two-card horizontal layout */
    .masonry-grid.two-cards {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      justify-content: start;
    }

    .masonry-card {
      width: 100%;
      max-width: 100%;
      flex-shrink: 0;
      overflow: hidden;
      border-radius: 26px;
      background: var(--panel-strong);
      border: 1px solid var(--line);
      box-shadow: 0 18px 46px rgba(93, 73, 172, 0.08);
      cursor: pointer;
      transition: transform 180ms ease, box-shadow 180ms ease;
      box-sizing: border-box;
      position: relative;
    }

    .masonry-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 22px 52px rgba(93, 73, 172, 0.14);
    }

    .card-media {
      position: relative;
      width: 100%;
      height: 280px;
      background:
        radial-gradient(circle at 22% 18%, rgba(255, 255, 255, 0.42), transparent 18%),
        linear-gradient(145deg, #cdbdff, #8370ea 58%, #4a43b8);
      background-size: cover;
      background-position: center;
    }

    .card-media.media-short,
    .card-media.media-medium,
    .card-media.media-tall {
      height: 280px;
    }

    .card-pill {
      position: absolute;
      top: 16px;
      left: 16px;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.8);
      color: var(--text-strong);
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
    }

    .card-pill.subtle {
      top: auto;
      bottom: 16px;
      background: rgba(255, 255, 255, 0.22);
    }

    .card-body { padding: 18px; }

    .card-body h3 {
      margin: 0;
      color: var(--text-strong);
      letter-spacing: -0.05em;
    }

    .card-body p {
      color: var(--muted);
      line-height: 1.65;
    }

    .meta-author {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 12px;
    }

    .card-location {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }

    .store-badge, .location-badge {
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.74rem;
      background: rgba(103, 88, 255, 0.08);
      color: var(--text);
    }

    .detail-tag-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .tag-pill {
      min-height: 36px;
      padding: 0 12px;
      border-radius: 999px;
      color: var(--accent);
      background: rgba(103, 88, 255, 0.08);
    }

    .compact-tags { margin-bottom: 14px; }

    .post-stats {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 16px;
    }

    .post-stats button {
      min-height: 38px;
      padding: 0 12px;
      border-radius: 999px;
      color: var(--text);
      background: rgba(103, 88, 255, 0.08);
    }

    .post-stats button.is-active {
      color: white;
      background: linear-gradient(135deg, var(--accent), var(--accent-soft));
    }

    /* Xuehan Wang (Responsibilities: Post Detail & Comments, Create & Upload Functions, Modals & Notifications): Right rail panel */
    .right-rail {
      display: grid;
      gap: 20px;
      align-content: start;
    }

    .panel {
      padding: 20px;
      border-radius: 28px;
      background: var(--panel);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
    }

    .panel-header h2 { font-size: 1.5rem; }

    .trending-list, .notification-preview {
      display: grid;
      gap: 14px;
    }

    .trend-item {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 14px;
      padding: 16px;
      border-radius: 20px;
      background: white;
      border: 1px solid var(--line);
    }

    .trend-item strong {
      font-size: 2rem;
      line-height: 1;
      color: rgba(103, 88, 255, 0.2);
    }

    .notification-item {
      display: grid;
      gap: 10px;
      padding: 16px;
      border-radius: 20px;
      background: white;
      border: 1px solid var(--line);
    }

    .notification-item.unread {
      border-color: rgba(103, 88, 255, 0.26);
      box-shadow: inset 0 0 0 1px rgba(103, 88, 255, 0.1);
    }

    .notification-item strong { display: block; }
    .notification-item span { color: var(--muted); }

    .upgrade-card {
      padding: 26px;
      border-radius: 30px;
      color: white;
      background: linear-gradient(145deg, #5f4fff, #4f3be6);
      box-shadow: 0 26px 60px rgba(79, 59, 230, 0.24);
    }

    .upgrade-card h3 {
      margin: 14px 0;
      font-size: 2rem;
      line-height: 1.04;
      letter-spacing: -0.05em;
    }

    .upgrade-card p {
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.65;
    }

    .secondary-inverse {
      width: 100%;
      min-height: 48px;
      padding: 0 18px;
      border-radius: 16px;
      color: var(--accent);
      background: white;
      cursor: pointer;
    }

    .empty-card {
      padding: 26px;
      border-radius: 20px;
      background: white;
      border: 1px solid var(--line);
    }

    .empty-card h3 {
      margin: 0;
      color: var(--text-strong);
    }

    .empty-card p {
      color: var(--muted);
      line-height: 1.65;
    }

    .ghost-button {
      color: var(--accent);
      background: transparent;
      cursor: pointer;
    }

    .text-button {
      color: var(--accent);
      background: transparent;
      cursor: pointer;
    }

    .micro-label {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      min-height: 32px;
      padding: 0 14px;
      border-radius: 999px;
      font-size: 0.76rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      background: rgba(103, 88, 255, 0.08);
    }

    .demo-mode-badge {
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(102, 93, 228, 0.14);
      color: var(--text);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    /* Xuehan Wang (Responsibilities: Post Detail & Comments, Create & Upload Functions, Modals & Notifications): Detail overlay and post detail page */
    .detail-overlay {
      position: fixed;
      inset: 0;
      z-index: 15;
      overflow: auto;
      background: rgba(244, 239, 255, 0.96);
      backdrop-filter: blur(14px);
    }

    .detail-shell {
      width: var(--shell);
      min-height: calc(100vh - 20px);
      margin: 10px auto;
      padding: 18px;
      border-radius: 28px;
      background: rgba(250, 247, 255, 0.98);
      border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .detail-topbar {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 18px;
    }

    .back-button {
      color: var(--accent);
      background: transparent;
      cursor: pointer;
    }

    .detail-topbar-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .detail-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) 360px;
      gap: 18px;
      margin-top: 18px;
    }

    .detail-hero {
      min-height: 720px;
      border-radius: 22px;
      background-size: cover;
      background-position: center;
    }

    .thumbnail-row {
      display: flex;
      gap: 12px;
      margin-top: 16px;
      flex-wrap: wrap;
    }

    .thumbnail {
      width: 72px;
      height: 72px;
      border-radius: 16px;
      border: 3px solid transparent;
      background-size: cover;
      background-position: center;
      cursor: pointer;
    }

    .thumbnail.is-active { border-color: var(--accent); }

    .detail-info-panel {
      padding: 22px;
      border-radius: 24px;
      background: var(--panel);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }

    .detail-badges {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .detail-badge {
      min-height: 36px;
      padding: 0 12px;
      border-radius: 999px;
      color: var(--accent);
      background: rgba(103, 88, 255, 0.08);
    }

    .detail-action-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .action-pill {
      min-height: 36px;
      padding: 0 12px;
      border-radius: 999px;
      color: var(--accent);
      background: rgba(103, 88, 255, 0.08);
      cursor: pointer;
    }

    .action-pill.is-active {
      color: white;
      background: linear-gradient(135deg, var(--accent), var(--accent-soft));
    }

    .detail-author-card {
      margin: 20px 0;
      padding: 14px;
      border-radius: 18px;
      background: rgba(245, 240, 255, 0.9);
    }

    .detail-metric-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .detail-metric {
      padding: 16px;
      border-radius: 18px;
      background: rgba(245, 240, 255, 0.86);
    }

    .detail-metric small {
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-weight: 700;
    }

    .detail-metric strong {
      display: block;
      margin-top: 6px;
      color: var(--text-strong);
      font-size: 1.5rem;
      letter-spacing: -0.05em;
    }

    .detail-footer-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 18px;
      color: var(--muted);
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .detail-footer-row button {
      padding: 0;
      min-height: auto;
      color: inherit;
      background: transparent;
    }

    .detail-footer-row .danger { color: var(--danger); }

    /* Xuehan Wang (Responsibilities: Post Detail & Comments, Create & Upload Functions, Modals & Notifications): Comments panel */
    .comments-panel {
      max-width: 980px;
      margin-top: 28px;
    }

    .comments-header {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
    }

    .comments-header h2 { font-size: 1.5rem; }
    .comments-header span { color: var(--accent-soft); font-size: 1.5rem; }

    .comment-form {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 18px;
      margin: 20px 0;
      padding: 14px;
      border-radius: 18px;
      background: rgba(245, 240, 255, 0.9);
    }

    .send-button {
      width: 54px;
      min-height: 48px;
      padding: 0;
      border-radius: 16px;
      color: white;
      background: linear-gradient(135deg, var(--accent), var(--accent-soft));
      cursor: pointer;
    }

    .comment-form input {
      width: 100%;
      min-height: 54px;
      padding: 0 18px;
      border-radius: 16px;
      border: 1px solid transparent;
      outline: none;
      color: var(--text-strong);
      background: rgba(241, 236, 255, 0.66);
    }

    .comment-item {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 14px;
    }

    .comment-content {
      padding: 12px 14px;
      border-radius: 18px;
      background: white;
      border: 1px solid var(--line);
    }

    .comment-content p {
      margin: 8px 0 10px;
      color: var(--muted);
      line-height: 1.65;
    }

    .comment-thread { display: grid; gap: 14px; }
    .comment-thread .comment-thread { margin-top: 12px; margin-left: 18px; }

    .comment-time {
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 700;
      color: var(--muted);
    }

    .comment-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      color: var(--muted);
      font-size: 0.86rem;
    }

    .comment-item.is-pinned {
      border-left: 3px solid rgba(96, 88, 234, 0.8);
      padding-left: 14px;
    }

    .comment-item.is-nested { margin-left: 18px; }

    .show-more-replies {
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px solid var(--line);
    }

    /* Xuehan Wang (Responsibilities: Post Detail & Comments, Create & Upload Functions, Modals & Notifications): Create post modal */
    .modal {
      position: fixed;
      inset: 0;
      z-index: 30;
    }

    .modal-mask {
      position: absolute;
      inset: 0;
      background: rgba(35, 25, 71, 0.36);
      backdrop-filter: blur(8px);
    }

    .modal-panel {
      position: absolute;
      top: 50%;
      left: 50%;
      right: auto;
      width: min(820px, calc(100vw - 24px));
      max-height: calc(100vh - 32px);
      padding: 22px;
      border-radius: 28px;
      overflow: auto;
      background: rgba(251, 249, 255, 0.98);
      transform: translate(-50%, -50%);
      border: 1px solid var(--line);
      box-shadow: var(--shadow);
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
    }

    .create-form {
      display: grid;
      gap: 18px;
    }

    .create-form label {
      display: grid;
      gap: 8px;
    }

    .create-form span {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted);
    }

    .create-form input, .create-form textarea {
      width: 100%;
      min-height: 54px;
      padding: 0 18px;
      border-radius: 16px;
      border: 1px solid transparent;
      outline: none;
      color: var(--text-strong);
      background: rgba(241, 236, 255, 0.66);
    }

    .create-form textarea {
      min-height: 136px;
      padding: 16px 18px;
      resize: vertical;
    }

    .create-form input:focus, .create-form textarea:focus {
      border-color: rgba(103, 88, 255, 0.3);
