    // Xuehan Wang (Detail, Comments, Modals): Handle detail actions (like, bookmark, share, etc.)
    function handleDetailAction(action, post) {
      if (action === "like") {
        if (state.likedPostIds.includes(post.id)) {
          state.likedPostIds = state.likedPostIds.filter(id => id !== post.id);
          post.likes--;
        } else {
          state.likedPostIds.push(post.id);
          post.likes++;
        }
        showToast(state.likedPostIds.includes(post.id) ? "Liked!" : "Unliked");
      }
      if (action === "bookmark") {
        if (state.bookmarkedPostIds.includes(post.id)) {
          state.bookmarkedPostIds = state.bookmarkedPostIds.filter(id => id !== post.id);
        } else {
          state.bookmarkedPostIds.push(post.id);
        }
        showToast(state.bookmarkedPostIds.includes(post.id) ? "Saved!" : "Removed from bookmarks");
      }
      if (action === "share") {
        navigator.clipboard.writeText(`https://curator.gold/post/${post.id}`);
        showToast("Link copied to clipboard!");
      }
      if (action === "edit") {
        openCreateModal(post);
      }
      if (action === "report") {
        openReportModal(post.id, "post");
      }
      renderDetail(post);
      renderFeed();
    }

    // Xuehan Wang (Detail, Comments, Modals): Handle comment actions (reply, like, pin, delete)
    function handleCommentAction(action, commentId) {
      if (!state.detailPost) return;
      const comment = findComment(state.detailPost.comments, commentId);
      if (!comment) return;

      if (action === "reply") {
        state.replyParentId = commentId;
        state.replyParentName = comment.userName;
        els.replyBanner.classList.remove("hidden");
        els.replyTarget.textContent = comment.userName;
        els.commentInput.focus();
      }
      if (action === "like-comment") {
        comment.liked = !comment.liked;
        comment.likes += comment.liked ? 1 : -1;
        showToast(comment.liked ? "Liked!" : "Unliked");
      }
      if (action === "pin-comment") {
        comment.pinned = !comment.pinned;
        showToast(comment.pinned ? "Pinned!" : "Unpinned");
      }
      if (action === "delete-comment") {
        comment.deleted = true;
        showToast("Comment deleted");
      }
      renderComments();
    }

    // Xuehan Wang (Detail, Comments, Modals): Recursively find comment by ID
    function findComment(comments, id) {
      for (const c of comments) {
        if (c.id.toString() === id) return c;
        if (c.replies) {
          const found = findComment(c.replies, id);
          if (found) return found;
        }
      }
      return null;
    }

    // Xuehan Wang (Detail, Comments, Modals): Open create/edit post modal
    function openCreateModal(post = null) {
      if (post) {
        state.composeMode = "edit";
        state.editingPostId = post.id;
        els.createModalLabel.textContent = "Edit Post";
        els.createModalTitle.textContent = "Update your post";
        els.editingPostId.value = post.id;
        els.postTitle.value = post.title;
        els.postCategory.value = post.category;
        els.postPrice.value = post.priceRange;
        els.postLocation.value = post.location;
        els.postStoreName.value = post.storeName || "";
        els.postStoreAddress.value = post.storeAddress || "";
        els.postDescription.value = post.description;
        els.postTags.value = post.tags.join(", ");
      } else {
        state.composeMode = "create";
        state.editingPostId = null;
        els.createModalLabel.textContent = "Create Post";
        els.createModalTitle.textContent = "Upload a new local find";
        els.createPostForm.reset();
        els.editingPostId.value = "";
        els.suggestedTags.innerHTML = "";
        els.previewGrid.innerHTML = "";
      }
      els.createModal.classList.remove("hidden");
    }

    // Xuehan Wang (Detail, Comments, Modals): Close create post modal
    function closeCreateModal() {
      els.createModal.classList.add("hidden");
      els.createPostForm.reset();
      els.suggestedTags.innerHTML = "";
      els.previewGrid.innerHTML = "";
      els.createFormError.classList.add("hidden");
    }

    // Xuehan Wang (Detail, Comments, Modals): Handle AI tag suggestions
    function handleTagSuggestion() {
      const title = els.postTitle.value;
      const description = els.postDescription.value;
      if (!title && !description) {
        showToast("Please add a title or description first");
        return;
      }
      const suggestions = ["#discover", "#localfind", "#design", "#interior", "#curated", "#sustainable"];
      els.suggestedTags.innerHTML = suggestions.map(tag => {
        const btn = document.createElement("button");
        btn.className = "tag-pill";
        btn.textContent = tag;
        btn.addEventListener("click", () => {
          const current = els.postTags.value;
          els.postTags.value = current ? `${current}, ${tag}` : tag;
        });
        return btn.outerHTML;
      }).join("");
      showToast("AI tag suggestions generated");
    }

    // Xuehan Wang (Detail, Comments, Modals): Handle create post form submission
    function handleCreateSubmit(e) {
      e.preventDefault();
      if (!els.postTitle.value || !els.postCategory.value || !els.postLocation.value) {
        els.createFormError.textContent = "Please fill in required fields (Title, Category, Location)";
        els.createFormError.classList.remove("hidden");
        return;
      }

      const postData = {
        id: state.editingPostId || Date.now(),
        authorId: state.user.id,
        authorName: state.user.name,
        authorRole: state.user.role,
        avatar: state.user.avatar,
        title: els.postTitle.value,
        category: els.postCategory.value,
        priceRange: els.postPrice.value,
        location: els.postLocation.value,
        storeName: els.postStoreName.value,
        storeAddress: els.postStoreAddress.value,
        description: els.postDescription.value,
        tags: els.postTags.value.split(",").map(t => t.trim()).filter(Boolean),
        visualStyle: "art-copper",
        likes: 0,
        saves: 0,
        shares: 0,
        views: 0,
        commentCount: 0,
        liked: false,
        bookmarked: false,
        shared: false,
        editable: true,
        visibility: "public",
        comments: [],
      };

      if (state.editingPostId) {
        const index = state.posts.findIndex(p => p.id === parseInt(state.editingPostId));
        if (index !== -1) state.posts[index] = postData;
        showToast("Post updated!");
      } else {
        state.posts.unshift(postData);
        showToast("Post created!");
      }

      closeCreateModal();
      navigate("feed");
    }

    // Xuehan Wang (Detail, Comments, Modals): Open image search modal
    function openImageSearch() {
      els.imageSearchModal.classList.remove("hidden");
      els.imageSearchFile.value = "";
      els.imagePreviewContainer.classList.add("hidden");
      els.searchStatus.classList.add("hidden");
      els.searchResults.classList.add("hidden");
      els.submitImageSearch.disabled = true;
    }

    // Xuehan Wang (Detail, Comments, Modals): Close image search modal
    function closeImageSearch() {
      els.imageSearchModal.classList.add("hidden");
      els.imageSearchFile.value = "";
      els.imagePreviewContainer.classList.add("hidden");
      els.searchStatus.classList.add("hidden");
      els.searchResults.classList.add("hidden");
    }

    // Xuehan Wang (Detail, Comments, Modals): Handle image search file selection
    function handleImageSearchFile(e) {
      const file = e.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        els.previewImage.style.backgroundImage = `url(${event.target.result})`;
        els.imagePreviewContainer.classList.remove("hidden");
        els.submitImageSearch.disabled = false;
      };
      reader.readAsDataURL(file);
    }

    // Xuehan Wang (Detail, Comments, Modals): Remove image search preview
    function removePreviewImage() {
      els.imageSearchFile.value = "";
      els.imagePreviewContainer.classList.add("hidden");
      els.submitImageSearch.disabled = true;
    }

    // Xuehan Wang (Detail, Comments, Modals): Handle image search execution
    function handleImageSearch() {
      els.searchStatus.classList.remove("hidden");
      els.searchResults.classList.add("hidden");
      setTimeout(() => {
        els.searchStatus.classList.add("hidden");
        els.searchResults.classList.remove("hidden");
        els.similarPostsGrid.innerHTML = state.posts.slice(0, 6).map(p => `
          <div class="similar-post-card" style="background: ${visualStyles[p.visualStyle] || visualStyles["art-copper"]}" data-post-id="${p.id}"></div>
        `).join("");
        els.similarPostsGrid.querySelectorAll(".similar-post-card").forEach(card => {
          card.addEventListener("click", () => {
            const postId = parseInt(card.dataset.postId);
            const post = state.posts.find(p => p.id === postId);
            if (post) {
              closeImageSearch();
              openDetail(post);
            }
          });
        });
      }, 2000);
    }

    // Xuehan Wang (Detail, Comments, Modals): Open report modal
    function openReportModal(targetId, targetType) {
      els.reportTargetId.value = targetId;
      els.reportTargetType.value = targetType;
      els.reportReasons.forEach(r => r.classList.remove("is-selected"));
      els.reportCustomReason.classList.add("hidden");
      els.submitReportButton.disabled = true;
      els.reportMessage.value = "";
      els.reportModal.classList.remove("hidden");
    }

    // Xuehan Wang (Detail, Comments, Modals): Close report modal
    function closeReportModal() {
      els.reportModal.classList.add("hidden");
    }

    // Xuehan Wang (Detail, Comments, Modals): Handle report reason selection
    function handleReportReason(e) {
      els.reportReasons.forEach(r => r.classList.remove("is-selected"));
      e.target.closest(".report-reason").classList.add("is-selected");
      els.reportCustomReason.classList.toggle("hidden", e.target.closest(".report-reason").dataset.reason !== "other");
      els.submitReportButton.disabled = false;
    }

    // Xuehan Wang (Detail, Comments, Modals): Handle report submission
    function handleReportSubmit() {
      const reason = document.querySelector(".report-reason.is-selected")?.dataset.reason;
      const message = els.reportMessage.value;
      showToast("Report submitted. Thank you for helping keep our community safe.");
      closeReportModal();
    }

    // Xuehan Wang (Detail, Comments, Modals): Handle comment submission
    function handleCommentSubmit(e) {
      e.preventDefault();
      const text = els.commentInput.value.trim();
      if (!text) return;

      const newComment = {
        id: Date.now(),
        authorId: state.user.id,
        parentId: state.replyParentId,
        userName: state.user.name,
        avatar: state.user.avatar,
        text,
        createdLabel: "just now",
        mine: true,
        liked: false,
        pinned: false,
        pinnable: true,
        deletable: true,
        deleted: false,
        likes: 0,
        replies: [],
      };

      if (state.replyParentId) {
        const parent = findComment(state.detailPost.comments, state.replyParentId);
        if (parent) parent.replies.push(newComment);
      } else {
        state.detailPost.comments.push(newComment);
      }

      els.commentInput.value = "";
      state.replyParentId = null;
      state.replyParentName = "";
      els.replyBanner.classList.add("hidden");
      renderComments();
      showToast("Comment posted!");
    }

    // Chenqing Fu & Xuehan Wang (Shared): Initialize application
    function init() {
      els.sidebarName.textContent = state.user.name;
      els.sidebarRole.textContent = state.user.role;
      els.sidebarAvatar.textContent = state.user.avatar;
      els.detailAvatar.textContent = state.user.avatar;
      els.commentUserAvatar.textContent = state.user.avatar;

      els.routeButtons.forEach(btn => btn.addEventListener("click", () => navigate(btn.dataset.route)));
      els.filterButtons.forEach(btn => btn.addEventListener("click", () => {
        els.filterButtons.forEach(b => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        state.filter = btn.dataset.filter;
        renderFeed();
      }));

      els.globalSearch.addEventListener("input", (e) => {
        state.query = e.target.value;
        renderFeed();
      });

      els.closeDetail.addEventListener("click", closeDetail);
      els.commentForm.addEventListener("submit", handleCommentSubmit);
      els.cancelReply.addEventListener("click", () => {
        state.replyParentId = null;
        state.replyParentName = "";
        els.replyBanner.classList.add("hidden");
      });

      els.openCreatePost.addEventListener("click", () => openCreateModal());
      els.closeCreateMask.addEventListener("click", closeCreateModal);
      els.closeCreateButton.addEventListener("click", closeCreateModal);
      els.cancelCreateButton.addEventListener("click", closeCreateModal);
      els.createPostForm.addEventListener("submit", handleCreateSubmit);
      els.suggestTagsButton.addEventListener("click", handleTagSuggestion);

      els.openImageSearch.addEventListener("click", openImageSearch);
      els.closeImageSearchMask.addEventListener("click", closeImageSearch);
      els.closeImageSearchButton.addEventListener("click", closeImageSearch);
      els.cancelImageSearchButton.addEventListener("click", closeImageSearch);
      els.imageSearchFile.addEventListener("change", handleImageSearchFile);
      els.removePreviewImage.addEventListener("click", removePreviewImage);
      els.submitImageSearch.addEventListener("click", handleImageSearch);

      els.reportReasons.forEach(r => r.addEventListener("click", handleReportReason));
      els.closeReportMask.addEventListener("click", closeReportModal);
      els.closeReportButton.addEventListener("click", closeReportModal);
      els.cancelReportButton.addEventListener("click", closeReportModal);
      els.submitReportButton.addEventListener("click", handleReportSubmit);

      navigate("feed");
    }

    window.addEventListener("popstate", (e) => {
      if (e.state?.route) navigate(e.state.route);
    });

    init();
  </script>
</body>
</html>
